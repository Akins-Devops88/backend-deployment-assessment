# StartupTech AWS Infrastructure Configuration
# Copy this file to terraform.tfvars and customize it.
# Do not commit the real terraform.tfvars file.

# AWS Region
aws_region = "us-east-1"

# Project Name
project_name = "startuptech"

# VPC CIDR
vpc_cidr = "10.0.0.0/16"

# EC2 Instance Type
instance_type = "t3.micro"

# Replace with your current public IP address followed by /32
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"

# Replace with the name of an existing AWS EC2 key pair
key_name = "YOUR_EC2_KEY_PAIR_NAME"
